# ============================================================
# FoodRush Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.

# Server
PORT=3000
NODE_ENV=development

# Database (Supabase / PostgreSQL)
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# JWT Secret — use a long random string (min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Admin Portal Credentials (hardcoded — NOT from database, NO self-registration)
# The admin logs in using these values from the Admin ID + Secret Key fields.
# Change these to something secure before deployment!
ADMIN_ID=foodrush_admin
ADMIN_SECRET=Admin@FoodRush

# Cloudinary — for storing seal photos and food images
# Get from: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay — for payments
# Get from: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email (optional — for order confirmations)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM=noreply@foodrush.com

# Twilio (optional — for SMS OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1XXXXXXXXXX
